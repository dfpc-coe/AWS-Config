{
    "compilerOptions": {
        "strict": true,
        "strictNullChecks": true,
        "noImplicitAny": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "lib": ["es2023"],
        "types": ["node"],
        "skipLibCheck": true,
        "removeComments": true,
        "rootDir": ".",
        "outDir": "dist"
    },
    "include": [
        "index.cts",
        "remediations/*.cts",
        "cloudformation/**/*.ts",
        "test/*.ts",
        "types/*.d.ts"
    ]
}
